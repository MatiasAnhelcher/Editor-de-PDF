<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group
                android:name="doc"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.5"
                android:scaleY="0.5"
                android:translateY="1">
                <!-- Hoja con relleno translúcido y trazo blanco -->
                <path
                    android:fillColor="#20FFFFFF"
                    android:pathData="M29,56 V26 C29,22.13 32.13,19 36,19 H60 L77,36 V79 C77,82.87 73.87,86 70,86 H52"
                    android:strokeWidth="5"
                    android:strokeColor="#FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
                <!-- Pliegue superior -->
                <path
                    android:pathData="M59,19 V33 C59,35.21 60.79,37 63,37 H77"
                    android:strokeWidth="4.5"
                    android:strokeColor="#FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
                <!-- Renglones: el segundo, resaltado -->
                <path
                    android:pathData="M39,35 L51,35"
                    android:strokeWidth="4"
                    android:strokeColor="#E0E7FF"
                    android:strokeLineCap="round" />
                <group android:name="highlight" android:pivotX="39" android:scaleX="0">
                <path
                    android:pathData="M39,46 L64,46"
                    android:strokeWidth="4"
                    android:strokeColor="#00F5D4"
                    android:strokeLineCap="round" />
                </group>
                <!-- Lápiz -->
                <group android:name="pen" android:translateX="16" android:translateY="-12">
                <path
                    android:fillColor="#FFFFFF"
                    android:pathData="M79,43 L86,50 L70,66 L61,68 L63,59 Z" />
                <path
                    android:fillColor="#00F5D4"
                    android:pathData="M82,40 L89,47 L86,50 L79,43 Z" />
                </group>
                <!-- Pastilla "PDF" -->
                <group android:name="badge" android:pivotX="43" android:pivotY="70" android:scaleX="0.4" android:scaleY="0.4">
                <path
                    android:fillColor="#FF2E63"
                    android:pathData="M26,58 H60 C63.87,58 67,61.13 67,65 V75 C67,78.87 63.87,82 60,82 H26 C22.13,82 19,78.87 19,75 V65 C19,61.13 22.13,58 26,58 Z" />
                <path
                    android:pathData="M27,75 V65 H31.8 C33.7,65 35,66.1 35,67.9 C35,69.7 33.7,70.8 31.8,70.8 H27 M39,65 H42.6 C45.5,65 47.6,67.1 47.6,70 C47.6,72.9 45.5,75 42.6,75 H39 Z M52,75 V65 H58.5 M52,69.9 H57"
                    android:strokeWidth="2.9"
                    android:strokeColor="#FFFFFF"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="doc">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="520"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="0"
                    android:valueFrom="0.5"
                    android:valueTo="0.72"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="520"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="0"
                    android:valueFrom="0.5"
                    android:valueTo="0.72"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="highlight">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="360"
                    android:interpolator="@android:interpolator/fast_out_slow_in"
                    android:propertyName="scaleX"
                    android:startOffset="320"
                    android:valueFrom="0"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="pen">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="380"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="translateX"
                    android:startOffset="420"
                    android:valueFrom="16"
                    android:valueTo="0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="380"
                    android:interpolator="@android:interpolator/decelerate_cubic"
                    android:propertyName="translateY"
                    android:startOffset="420"
                    android:valueFrom="-12"
                    android:valueTo="0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="badge">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:startOffset="520"
                    android:valueFrom="0.4"
                    android:valueTo="1"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="420"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:startOffset="520"
                    android:valueFrom="0.4"
                    android:valueTo="1"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
