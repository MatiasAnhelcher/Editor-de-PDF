<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:titleTextAppearance="@style/TextAppearance.EditorPDF.Title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.matias.editorpdf.view.PdfDocumentView
            android:id="@+id/pdf_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@drawable/page_indicator_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="#FFFFFF" />

        <!-- Herramientas flotantes, al estilo de GoodNotes / Notability -->
        <LinearLayout
            android:id="@+id/tool_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/options_panel"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/swatches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/color_meaning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/shape_types"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="horizontal"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/options_divider"
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:layout_marginHorizontal="12dp"
                        android:background="?attr/colorOutlineVariant" />

                    <TextView
                        android:id="@+id/width_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="84dp"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/width_slider"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="100"
                        android:value="10"
                        app:labelBehavior="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/straight_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/straight_line" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/snap_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/snap_to_text" />

                    <TextView
                        android:id="@+id/lasso_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:maxWidth="320dp"
                        android:text="@string/lasso_hint"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/selection_delete"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/delete_selection"
                        app:icon="@drawable/ic_delete" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="32dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:id="@+id/tool_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="6dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_hand"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_hand"
                    android:tooltipText="@string/tool_hand"
                    app:icon="@drawable/ic_tool_move" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_pen"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_pen"
                    android:tooltipText="@string/tool_pen"
                    app:icon="@drawable/ic_tool_pen" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_highlighter"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_highlighter"
                    android:tooltipText="@string/tool_highlighter"
                    app:icon="@drawable/ic_tool_highlighter" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_underline"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_underline"
                    android:tooltipText="@string/tool_underline"
                    app:icon="@drawable/ic_tool_underline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_strike"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_strike"
                    android:tooltipText="@string/tool_strike"
                    app:icon="@drawable/ic_tool_strike" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_shape"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_shape"
                    android:tooltipText="@string/tool_shape"
                    app:icon="@drawable/ic_tool_shape" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_text"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_text"
                    android:tooltipText="@string/tool_text"
                    app:icon="@drawable/ic_tool_text" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_note"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_note"
                    android:tooltipText="@string/tool_note"
                    app:icon="@drawable/ic_tool_note" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_lasso"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_lasso"
                    android:tooltipText="@string/tool_lasso"
                    app:icon="@drawable/ic_tool_lasso" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_eraser"
                    style="@style/Widget.EditorPDF.ToolButton"
                    android:contentDescription="@string/tool_eraser"
                    android:tooltipText="@string/tool_eraser"
                    app:icon="@drawable/ic_tool_eraser" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <include layout="@layout/study_panel" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/review_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/review_tip"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_show_all"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/review_show_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_hide_all"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/review_hide_all" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_cards"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/cards" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/review_exit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/review_exit" />
    </LinearLayout>

</LinearLayout>
